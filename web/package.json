{
  "name": "@bibikitchen/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run cf-typegen && tsc --noEmit",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.110.0"
  }
}
