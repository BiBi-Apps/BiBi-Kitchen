{
  "name": "@bibikitchen/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "wrangler deploy --config dist/bibi_kitchen/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "lint": "concurrently -m 1 --timings npm:lint:*",
    "lint:type-check": "npm run cf-typegen && tsc --noEmit",
    "lint:formatter": "oxfmt --check",
    "lint:oxlint": "oxlint",
    "fix": "concurrently -m 1 --timings npm:fix:*",
    "fix:formatter": "oxfmt",
    "fix:oxlint": "oxlint --fix"
  },
  "dependencies": {
    "@bibikitchen/web-constant": "*",
    "@bibikitchen/web-service": "*",
    "@bibikitchen/webpage": "*",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.110.0"
  }
}
