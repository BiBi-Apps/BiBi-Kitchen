{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["KV_NAMESPACE_ID", "D1_DATABASE_ID", "ENVIRONMENT"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["KV_NAMESPACE_ID", "D1_DATABASE_ID", "ENVIRONMENT"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "fix": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate:local": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
